{
  "docs_dir": "spek-fu/project/code-docs",
  "source_globs": [
    "**/*.py",
    "**/*.js",
    "**/*.ts",
    "**/*.jsx",
    "**/*.tsx",
    "**/*.go",
    "**/*.rs",
    "**/*.java",
    "**/*.cs",
    "**/*.cpp",
    "**/*.c",
    "**/*.h",
    "**/*.rb",
    "**/*.sh"
  ],
  "exclude_globs": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/__pycache__/**",
    "**/*.min.js",
    "spek-fu/plugins/doc-engine/scripts/dokfu/**",
    "spek-fu/project/code-docs/**",
    ".venv/**",
    "*.venv/**",
    "htmlcov/**",
    ".htmlcov/**",
    "coverage_html_scan/**",
    "**/coverage/**",
    "**/*-debug.js",
    "spek-fu/plugins/doc-engine/scripts/dokfu.py",
    "**/obj/**",
    "**/bin/**",
    "artifacts/**",
    ".claude/worktrees/**"
  ],
  "pointer_token": "dok-fu",
  "comment_map": {
    ".py":   "#",
    ".js":   "//",
    ".ts":   "//",
    ".jsx":  "//",
    ".tsx":  "//",
    ".go":   "//",
    ".rs":   "//",
    ".java": "//",
    ".cs":   "//",
    ".cpp":  "//",
    ".c":    "//",
    ".h":    "//",
    ".rb":   "#",
    ".sh":   "#"
  },
  "registry_path": "spek-fu/plugins/doc-engine/knowledge/tags.registry.json",
  "manifest_path": "spek-fu/project/code-docs/.dokfu-manifest.json",
  "dokfu_dir": "spek-fu/plugins/doc-engine"
}
