{
    "chat.tools.terminal.autoApprove": {
        "ls": true,
        "cat": true,
        "head": true,
        "tail": true,
        "wc": true,
        "pwd": true,
        "grep": true,
        "find": true,
        "echo": true,
        "which": true,
        "uname": true,
        "Get-ChildItem": true,
        "Get-Content": true,
        "Get-Location": true,
        "Write-Output": true,
        "Select-String": true,
        "Test-Path": true,
        "npm list": true,
        "npm test": true,
        "npm run lint": true,
        "pip list": true,
        "pytest": true,
        "cargo tree": true,
        "cargo test": true,
        "go test": true,
        "/^git\\s+(status|diff|log|show|branch)\\b/": true,
        "spek-fu/ai/scripts/**": true,
        "rm": false,
        "rmdir": false,
        "del": false,
        "sudo": false,
        "curl": false,
        "wget": false,
        "eval": false,
        "kill": false,
        "killall": false,
        "chmod": false,
        "chown": false,
        "Invoke-Expression": false,
        "iex": false,
        "/^rm\\s+-rf/": false,
        "/^git\\s+(push|reset|clean)\\b/": false,
        "/^docker\\s+(rm|rmi|system\\s+prune)\\b/": false,
        "/^kubectl\\s+(delete|apply)\\b/": false,
        "/^terraform\\s+(apply|destroy)\\b/": false
    },
    "chat.customAgentInSubagent.enabled": true,
    "search.exclude": {
        "**/node_modules": true,
        "**/bin": true,
        "**/obj": true
    },
    "python-envs.defaultEnvManager": "ms-python.python:system"
}
